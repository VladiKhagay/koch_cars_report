# Copy to .env.local and fill in (never commit the real .env.local).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the deployed Cloudflare Worker (worker/), e.g.
# https://car-prep-tracker-worker.<your-subdomain>.workers.dev
VITE_WORKER_URL=http://localhost:8787

# Optional: override the license-plate validation pattern for your country.
# Defaults to a permissive alphanumeric+hyphen pattern if unset.
VITE_PLATE_REGEX=^[A-Z0-9-]{5,10}$
