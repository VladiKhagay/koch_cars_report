# Loaded by Vite in test mode (vitest) only — never by dev or build.
#
# lib/supabase.ts calls createClient() at module scope, so importing anything
# that reaches it throws "supabaseUrl is required" when the vars are absent.
# That is invisible locally, where .env.local is present, and is why the CI
# web job failed while the same suite passed on a developer machine.
#
# Deliberately fake. No test makes a network call; these only have to parse.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=test-anon-key-not-a-real-credential
VITE_WORKER_URL=http://localhost:8787
